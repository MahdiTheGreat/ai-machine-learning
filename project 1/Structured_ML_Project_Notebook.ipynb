        "print(f\"BBBP: {len(bbbp)} molecules\")\n",
        "print(f\"  Train: {len(bbbp_train_dataset)}, Val: {len(bbbp_val_dataset)}, Test: {len(bbbp_test_dataset)}\")\n",
        "\n",
        "def print_data_info(dataset, name, visualize=False):\n",
